# ---------- Build Stage ----------
FROM python:3.9-slim AS builder
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc \
 && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ---------- Runtime Stage ----------
FROM python:3.9-slim AS runtime
WORKDIR /app

# Copia pacotes e executáveis (site‑packages + /usr/local/bin)
COPY --from=builder /usr/local /usr/local

# Copia aplicação e artefatos
COPY api/ /app/
COPY artifacts/ /app/artifacts
COPY api/estagios_config.json /app/estagios_config.json

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s \
  CMD curl -f http://127.0.0.1:8000/healthcheck || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "app:app", "--workers", "1"]
